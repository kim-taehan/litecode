{
  "name": "litecode",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "폐쇄망 원클릭 code assistant — opencode 를 엔진으로, Cordis 를 플러그인 뼈대로 쓴다",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "spike": "tsx src/index.ts",
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts"
  },
  "dependencies": {
    "cordis": "^4.0.0-rc.10",
    "electron": "^33.4.11",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright-core": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vitest": "^5.0.2"
  }
}
