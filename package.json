{
  "name": "litecode",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "폐쇄망 원클릭 code assistant — opencode 를 엔진으로, Cordis 를 플러그인 뼈대로 쓴다",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "spike": "tsx src/index.ts",
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run typecheck && npm run build:renderer && npm run build:electron",
    "dist:mac": "node scripts/fetch-opencode.mjs --check mac-arm64 mac-x64 && npm run build && electron-builder --mac",
    "dist:win": "node scripts/fetch-opencode.mjs --check win-x64 && npm run build && electron-builder --win",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:dist": "vitest run --config vitest.dist.config.ts"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "cordis": "^4.0.0-rc.10",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "micromark-core-commonmark": "^2.0.4",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-util-character": "^2.1.1",
    "micromark-util-classify-character": "^2.0.1",
    "micromark-util-symbol": "^2.0.1",
    "micromark-util-types": "^2.0.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "playwright-core": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
