{
  "expo": {
    "name": "litecode",
    "slug": "litecode-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "platforms": [
      "android"
    ],
    "android": {
      "package": "com.litecode.mobile"
    },
    "plugins": [
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "데스크탑의 연결 QR 을 읽으려고 카메라를 씁니다.",
          "recordAudioAndroid": false
        }
      ],
      "./plugins/withLoopbackCleartext.js"
    ]
  }
}
